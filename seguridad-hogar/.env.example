# Copiar este archivo como ".env" y completar. El .env NO se sube al repositorio.

# Contraseña que le pusiste a las cámaras Dahua/Hikvision (paso 5 de la guía)
CAMARA_PASSWORD=cambiame

# Ruta del dongle Sonoff Zigbee (paso 4 de la guía: ls -l /dev/serial/by-id/)
ZIGBEE_DONGLE=/dev/serial/by-id/usb-ITead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_XXXXXXXX-if00

# Carpeta donde se guardan las grabaciones (ideal: un disco de 1TB montado ahí)
GRABACIONES_DIR=/home/casa/grabaciones
